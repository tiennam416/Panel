        private bool IsCursorHidden()
        {
            CURSORINFO cursorInfo = new CURSORINFO();
            cursorInfo.cbSize = Marshal.SizeOf(cursorInfo);

            if (GetCursorInfo(ref cursorInfo))
            {
                return cursorInfo.flags == 0;
            }
            return false;
        }

        private bool IsProcessAlive()
        {
            try
            {
                if (_processId != -1)
                {
                    var proc = Process.GetProcessById(_processId);
                    return !proc.HasExited;
                }
                var processes = Process.GetProcessesByName("HD-Player");
                if (processes.Length > 0)
                {
                    _processId = processes[0].Id;
                    return true;
                }
                return false;
            }
            catch { return false; }
        }

        private bool ScanPattern()
        {
            try
            {
                UpdateStatus("Đang scan...");
                AimBotBtn.Enabled = false;

                if (!IsProcessAlive())
                {
                    UpdateStatus("Không tìm thấy HD-Player!");
                    AimBotBtn.Enabled = true;
                    return false;
                }

                if (memory == null)
                {
                    memory = new MemoryPatch("HD-Player");
                    var proc = Process.GetProcessesByName("HD-Player").FirstOrDefault();
                    if (proc != null) _processId = proc.Id;
                }

                string pattern = "01 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 00 00 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 00 ?? ?? ?? ?? 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 00 00 00 00 00 00 00 00 00 ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80 BF";

                var scanTask = Task.Run(() => memory.AoBScanMultiPattern(
                    new[] { pattern },
                    startAddress: 0x0000000000010000,
                    endAddress: 0x00007ffffffeffff,
                    customChunkSize: 0x800000
                ));

                if (!scanTask.Wait(TimeSpan.FromSeconds(30)))
                    throw new TimeoutException("Scan timeout");

                var results = scanTask.Result;
                _addresses = results.TryGetValue(pattern, out var list) ? list : new List<long>();

                if (_addresses == null || _addresses.Count == 0)
                {
                    UpdateStatus("Không tìm thấy địa chỉ!");
                    _isInitialized = false;
                    AimBotBtn.Enabled = true;
                    return false;
                }
                else
                {
                    _isInitialized = true;
                    UpdateStatus($"Tìm thấy {_addresses.Count} địa chỉ");
                    AimBotBtn.Enabled = true;
                    return true;
                }
            }
            catch (Exception ex)
            {
                UpdateStatus($"Scan lỗi: {ex.Message}");
                _isInitialized = false;
                AimBotBtn.Enabled = true;
                return false;
            }
        }

        private void StartAimbot()
        {
            if (_aimbotCts != null && !_aimbotCts.IsCancellationRequested) return;

            if (!IsProcessAlive())
            {
                UpdateStatus("Lỗi: Không tìm thấy HD-Player");
                return;
            }

            if (memory == null)
            {
                try
                {
                    memory = new MemoryPatch("HD-Player");
                    var proc = Process.GetProcessesByName("HD-Player").FirstOrDefault();
                    if (proc != null) _processId = proc.Id;
                }
                catch
                {
                    UpdateStatus("Lỗi: Không thể kết nối");
                    return;
                }
            }

            if (!_isInitialized || _addresses == null || _addresses.Count == 0)
            {
                UpdateStatus("Đang scan tự động...");
                if (!ScanPattern())
                {
                    MessageBox.Show("Scan thất bại! Vui lòng kiểm tra game đã mở chưa.", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }
            }

            _aimbotCts = new CancellationTokenSource();
            _isAimbotRunning = true;
            Task.Run(() => AimbotLoop(_aimbotCts.Token));
            UpdateStatus("Aimbot đang chạy...");
            AimBotBtn.Text = "Tắt Aimbot";
        }

        private void StopAimbot()
        {
            _aimbotCts?.Cancel();
            _aimbotCts = null;
            _addresses?.Clear();
            _isAimbotRunning = false;
            UpdateStatus("Aimbot đã dừng");
            AimBotBtn.Text = "Bật Aimbot";
        }

        int delay = 0;
        Random rand = new Random(); // Khởi tạo một lần ở ngoài hàm

        void UpdateDelayWithRandom()
        {
            int baseDelay = DelayTrackBar.Value;

            // Tạo hệ số ngẫu nhiên từ 0.5 đến 1.5 (tương đương +-50%)
            double randomMultiplier = 0.5 + (rand.NextDouble() * 1.0);

            // Gán giá trị vào biến delay
            delay = (int)(baseDelay * randomMultiplier);
        }

        private void AimbotLoop(CancellationToken token)
        {
            var patchAddresses = _addresses
                .Select(addr => new { ReadAddr = addr + OFFSET_READ, WriteAddr = addr + OFFSET_WRITE })
                .ToList();

            while (!token.IsCancellationRequested)
            {
                if (!IsProcessAlive())
                {
                    UpdateStatus("Mất kết nối! Đang chờ kết nối lại...");
                    while (!IsProcessAlive() && !token.IsCancellationRequested)
                        Thread.Sleep(1000);

                    if (token.IsCancellationRequested) break;
                    try
                    {
                        memory?.Dispose();
                        memory = new MemoryPatch("HD-Player");
                        UpdateStatus("Đã kết nối lại!");
                    }
                    catch
                    {
                        UpdateStatus("Không thể kết nối lại!");
                        break;
                    }
                }

                while (!token.IsCancellationRequested)
                {
                    bool isLeftButtonDown = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) != 0;
                    bool isCursorHidden = IsCursorHidden();

                    if (isLeftButtonDown && isCursorHidden)
                        break;

                    Thread.Sleep(1);
                }

                if (token.IsCancellationRequested) break;

                UpdateDelayWithRandom();

                for (int i = 0; i < delay && !token.IsCancellationRequested; i++)
                {
                    if ((GetAsyncKeyState(VK_LBUTTON) & 0x8000) == 0 || !IsCursorHidden())
                        goto WaitForRelease;
                    Thread.Sleep(1);
                }

                if (token.IsCancellationRequested) break;

                while (!token.IsCancellationRequested)
                {
                    bool isLeftButtonDown = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) != 0;
                    bool isCursorHidden = IsCursorHidden();

                    if (!isLeftButtonDown || !isCursorHidden)
                        break;

                    if (!IsProcessAlive())
                    {
                        UpdateStatus("Mất kết nối!");
                        goto WaitForRelease;
                    }

                    var values = new List<(long writeAddr, int value)>();
                    foreach (var p in patchAddresses)
                    {
                        try
                        {
                            values.Add((p.WriteAddr, memory.ReadMemory<int>(p.ReadAddr)));
                        }
                        catch { }
                    }

                    foreach (var (writeAddr, value) in values)
                    {
                        try { memory.WriteMemory(writeAddr, value); }
                        catch { }
                    }

                    int shdelay = rand.Next(2, 20);
                    Thread.Sleep(shdelay);
                }

            WaitForRelease:
                while (!token.IsCancellationRequested)
                {
                    bool isLeftButtonDown = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) != 0;
                    bool isCursorHidden = IsCursorHidden();

                    if (!isLeftButtonDown || !isCursorHidden)
                        break;

                    Thread.Sleep(1);
                }

                if (!token.IsCancellationRequested)
                {
                    for (int i = 0; i < RELEASE_DELAY && !token.IsCancellationRequested; i++)
                        Thread.Sleep(1);
                }
                Thread.Sleep(1);
            }

            _isAimbotRunning = false;
            UpdateStatus("Aimbot đã dừng");

            if (InvokeRequired)
            {
                Invoke(new Action(() =>
                {
                    AimBotBtn.Text = "Bật Aimbot";
                    AimBotBtn.Enabled = true;
                }));
            }
            else
            {
                AimBotBtn.Text = "Bật Aimbot";
                AimBotBtn.Enabled = true;
            }
        }
