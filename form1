        #region Hotkey Binding
        private IntPtr SetHook(LowLevelKeyboardProc proc)
        {
            using (Process curProcess = Process.GetCurrentProcess())
            using (ProcessModule curModule = curProcess.MainModule)
            {
                return SetWindowsHookEx(WH_KEYBOARD_LL, proc, GetModuleHandle(curModule.ModuleName), 0);
            }
        }

        private IntPtr HookCallback(int nCode, IntPtr wParam, IntPtr lParam)
        {
            if (nCode >= 0 && wParam == (IntPtr)WM_KEYDOWN)
            {
                int vkCode = Marshal.ReadInt32(lParam);
                Keys key = (Keys)vkCode;

                // ƯU TIÊN XỬ LÝ GÁN PHÍM TRƯỚC
                if (waitingForKeyButton != null)
                {
                    // Assign Key to Selected Button
                    if (key == Keys.Escape)
                    {
                        keyBindings[waitingForKeyButton] = Keys.None;
                        UpdateButtonText(waitingForKeyButton);
                    }
                    else
                    {
                        keyBindings[waitingForKeyButton] = key;
                        UpdateButtonText(waitingForKeyButton);
                    }
                    waitingForKeyButton = null;

                    // QUAN TRỌNG: Không thực thi action khi đang gán phím
                    return CallNextHookEx(hookID, nCode, wParam, lParam);
                }

                // CHỈ KHI KHÔNG ĐANG GÁN PHÍM MỚI KIỂM TRA VÀ THỰC THI ACTION
                // Check which key is pressed
                foreach (var kvp in keyBindings)
                {
                    if (kvp.Value == key)
                    {
                        Guna2Button button = kvp.Key;
                        if (keyActions.ContainsKey(button))
                        {
                            // Execute the action
                            keyActions[button]?.Invoke();
                        }
                        break;
                    }
                }
            }
            return CallNextHookEx(hookID, nCode, wParam, lParam);
        }

        private void UpdateButtonText(Guna2Button button)
        {
            if (button != null)
            {
                Keys key = keyBindings.ContainsKey(button) ? keyBindings[button] : Keys.None;
                button.Text = key == Keys.None ? "None" : key.ToString();
            }
        }

        // Public methods để quản lý hotkey từ bên ngoài
        public void RegisterHotkey(Guna2Button button, string displayName, Action action)
        {
            if (!keyBindings.ContainsKey(button))
            {
                keyBindings[button] = Keys.None;
                keyActions[button] = action;
                button.Tag = displayName; // Lưu tên hiển thị để dùng sau nếu cần
                button.Text = "None";
            }
        }

        public void UnregisterHotkey(Guna2Button button)
        {
            if (keyBindings.ContainsKey(button))
            {
                keyBindings.Remove(button);
                keyActions.Remove(button);
                button.Text = "None";
            }
        }

        public Keys GetHotkey(Guna2Button button)
        {
            return keyBindings.ContainsKey(button) ? keyBindings[button] : Keys.None;
        }

        public void SetHotkey(Guna2Button button, Keys key)
        {
            if (keyBindings.ContainsKey(button))
            {
                keyBindings[button] = key;
                UpdateButtonText(button);
            }
        }
